# Copy this file to .env and replace both values before starting.
NODE_ENV=development
PORT=3000
# Use a long random value (32+ characters). Example generation: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set a unique strong password (at least 14 characters); never put it in frontend files.
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_ADMIN_PASSWORD
# Optional path for persistent database
DB_PATH=./data/gkgs.sqlite
